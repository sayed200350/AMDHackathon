# ============================================================================
# Counsel-in-a-Box — Environment Variables
# ============================================================================
# Copy to .env and fill in your values:  cp .env.example .env

# --- Hugging Face ---
HF_TOKEN=hf_your_token_here

# --- Models ---
LEGAL_MODEL=Qwen/Qwen3-32B
ORCH_MODEL=Qwen/Qwen3.6-A3B

# --- vLLM Ports ---
LEGAL_PORT=8000
ORCH_PORT=8001

# --- vLLM Tuning ---
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.92
MAX_NUM_SEQS=8
DTYPE=bfloat16
TENSOR_PARALLEL_SIZE=1

# --- ROCm ---
HIP_VISIBLE_DEVICES=0
VLLM_USE_TRITON_FLASH_ATTN=1

# --- PostgreSQL ---
POSTGRES_DB=counsel
POSTGRES_USER=counsel
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://counsel:change_me_in_production@localhost:5432/counsel

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8080
